# Copy this file to .env.local and fill in your values.

# Create a key at https://aistudio.google.com/apikey and paste it below.
GEMINI_API_KEY=

# Optional: override the model used by /api/generate-plan.
# Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash

# Optional: comma separated models tried in order when the primary model is
# missing, rate limited, or the provider is overloaded.
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.8-flash

# MongoDB connection string used to store accounts.
# Local: mongodb://127.0.0.1:27017/gymai
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gymai
# Create a free cluster at https://cloud.mongodb.com
MONGO_URI=

# Secret used to sign the session cookie. Use a long random value.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
